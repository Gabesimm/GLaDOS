# Copy to .env (or set as Windows user environment variables). Never commit real values.
FISH_API_KEY=            # Fish Audio: text-to-speech + streaming voice
ELEVENLABS_API_KEY=      # ElevenLabs: speech-to-text / fallback TTS
GLADOS_BRAIN=openclaw    # "openclaw" = multi-agent gateway, unset = direct Claude Code
# GLADOS_GATEWAY_TOKEN is read from openclaw/gateway.token by openclaw-env.ps1
