{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${GLADOS_GATEWAY_TOKEN}"
    },
    "port": 18789,
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    },
    "controlUi": {
      "experimental": {
        "customPlugins": true
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "<ULTRON_ROOT>/openclaw/workspaces/glados",
      "cwd": "<ULTRON_ROOT>",
      "model": {
        "primary": "openai/gpt-6-luna",
        "fallbacks": [
          "anthropic/claude-sonnet-5",
          "ollama/qwen3:8b"
        ]
      },
      "models": {
        "openai/gpt-6-luna": {
          "agentRuntime": {
            "id": "codex"
          }
        },
        "openai/gpt-6-sol": {
          "agentRuntime": {
            "id": "codex"
          }
        },
        "openai/gpt-6-astra": {
          "agentRuntime": {
            "id": "codex"
          }
        },
        "anthropic/claude-sonnet-5": {
          "agentRuntime": {
            "id": "claude-cli"
          }
        },
        "anthropic/claude-opus-5": {
          "agentRuntime": {
            "id": "claude-cli"
          }
        },
        "ollama/qwen3:8b": {
          "agentRuntime": {
            "id": "openclaw"
          }
        }
      },
      "modelPolicy": {
        "allow": [
          "openai/gpt-6-luna",
          "anthropic/claude-sonnet-5",
          "openai/gpt-6-sol",
          "openai/gpt-6-astra",
          "anthropic/claude-opus-5",
          "ollama/qwen3:8b"
        ]
      },
      "thinkingDefault": "low",
      "fastModeDefault": false,
      "skipBootstrap": true,
      "bootstrapMaxChars": 7000,
      "bootstrapTotalMaxChars": 14000,
      "heartbeat": {
        "every": "0m"
      },
      "maxConcurrent": 2,
      "timeoutSeconds": 600,
      "systemAgent": {
        "agentId": "glados"
      },
      "subagents": {
        "delegationMode": "suggest",
        "maxConcurrent": 2,
        "maxSpawnDepth": 1,
        "maxChildrenPerAgent": 2,
        "runTimeoutSeconds": 480,
        "requireAgentId": true
      }
    },
    "ownership": "explicit",
    "entries": {
      "main": {
        "workspace": "<ULTRON_ROOT>/openclaw/workspaces/glados",
        "name": "GLaDOS legacy alias",
        "cwd": "<ULTRON_ROOT>",
        "agentDir": "<ULTRON_ROOT>/openclaw/agents/main/agent",
        "subagents": {
          "allowAgents": [
            "gpt-light",
            "gpt-work",
            "gpt-deep",
            "claude-work",
            "claude-deep"
          ],
          "delegationMode": "suggest"
        },
        "tools": {
          "allow": [
            "read",
            "ls",
            "view_image",
            "web_fetch",
            "agents_list",
            "sessions_spawn",
            "sessions_yield",
            "subagents",
            "sessions_history",
            "session_status",
            "write",
            "edit",
            "apply_patch",
            "exec",
            "process",
            "computer",
            "browser"
          ],
          "exec": {
            "host": "gateway",
            "security": "full",
            "ask": "off"
          }
        }
      },
