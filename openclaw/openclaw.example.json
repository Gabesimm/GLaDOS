  "plugins": {
    "entries": {
      "codex": {
        "enabled": true,
        "config": {
          "appServer": {
            "homeScope": "user"
          }
        }
      },
      "openai": {
        "enabled": true
      },
      "anthropic": {
        "enabled": true
      },
      "memory-core": {
        "enabled": false
      },
      "glados-3d-scene": {
        "enabled": true
      },
      "google": {
        "enabled": true
      },
      "antigravity": {
        "enabled": true,
        "config": {
          "mode": "plan"
        }
      },
      "discord": {
        "enabled": true
      },
      "cua-computer": {
        "enabled": true
      },
      "browser": {
        "enabled": true
      },
      "memory-lancedb": {
        "enabled": true
      },
      "active-memory": {
        "enabled": true,
        "config": {
          "enabled": true,
          "mode": "escalate",
          "agents": [
            "glados"
          ],
          "allowedChatTypes": [
            "direct"
          ],
          "modelFallback": "google/gemini-3-flash",
          "queryMode": "recent",
          "promptStyle": "balanced",
          "timeoutMs": 15000,
          "maxSummaryChars": 220,
          "persistTranscripts": false,
          "logging": true
        }
      },
      "fish-audio-speech": {
        "enabled": true
      }
    },
    "allow": [
      "codex",
      "openai",
      "anthropic",
      "glados-3d-scene",
      "cua-computer",
      "browser",
      "memory-lancedb",
      "active-memory",
      "fish-audio-speech"
    ],
    "load": {
      "paths": [
        "<ULTRON_ROOT>\\openclaw\\plugins\\glados-3d-scene"
      ]
    },
    "slots": {
      "memory": "memory-lancedb"
    }
  },
  "tools": {
    "deny": [
      "gateway",
      "cron"
    ],
    "sessions": {
      "visibility": "tree"
    },
    "elevated": {
      "enabled": false
    },
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off"
    },
    "media": {
      "models": [
        {
          "type": "cli",
          "command": "<ULTRON_ROOT>/tools/whisper-cpp/Release/whisper-cli.exe",
          "args": [
            "-m",
            "<ULTRON_ROOT>/tools/whisper-cpp/Release/ggml-small.en.bin",
            "-f",
            "{{AttachmentPath}}",
            "-nt",
            "--no-gpu"
          ],
          "timeoutSeconds": 60,
          "capabilities": [
            "audio"
          ]
        }
      ],
      "audio": {
        "enabled": true
      }
    }
  },
  "cron": {
    "enabled": false
  },
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434",
        "api": "ollama",
        "models": [
          {
            "id": "qwen3:8b",
            "name": "Qwen3 8B (local fallback)",
            "reasoning": true,
            "input": [
              "text"
            ],
            "contextWindow": 32768,
            "maxTokens": 8192
          }
        ]
      }
    }
  }
}